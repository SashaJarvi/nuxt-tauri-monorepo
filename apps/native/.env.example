# Overrides the API base URL the native app uses to reach the web server's
# shared API routes. Usually not needed — pnpm dev:ios / pnpm dev:android set
# this automatically via apps/native/scripts/dev-host.mjs (LAN IP autodetect),
# and pnpm dev:native defaults to http://localhost:3000.
# NUXT_PUBLIC_API_BASE_URL=http://<your-local-ip>:3000
